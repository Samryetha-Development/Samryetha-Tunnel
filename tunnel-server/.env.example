# ===== 运行角色 =====
# server = 完整服务端（HTTP 子域名/路径分发，跑在带域名那台，Caddy 反代）
# relay  = 纯 IP 中转（TCP 端口池，跑在 47.103.21.5）
ROLE=server
BIND=127.0.0.1
PORT=18080
BASE_DOMAIN=frp.example.com
# 路径隧道命名空间前缀：留空 -> /<用户名>/<隧道>；设为 /u -> /u/<用户名>/<隧道>
# （用于复用已存在的反代规则，例如 Caddy 已把 /u/* 转发到本服务）
PATH_NS=

# ===== 数据库（SQLite，首次运行自动建表）=====
DATABASE_URL=sqlite://tunnel.db?mode=rwc
# 或 sqlite:///var/lib/tunnel/tunnel.db?mode=rwc

# ===== 认证方式 =====
# oidc = 对接现有 Authentik/Lako 单点登录（生产）
# dev  = 本地开发，用邮箱直接签发会话/令牌，不连 IdP（仅测试）
AUTH_MODE=dev

# OIDC（AUTH_MODE=oidc 时必填）
# 授权码 + PKCE：Web 控制台走这个
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://frp.example.com/auth/callback
OIDC_SCOPES=openid profile email
# 设备码：桌面客户端（macOS/WinUI3）走这个，IdP 需支持 device flow
OIDC_DEVICE_ENABLED=true

# 管理员邮箱，逗号分隔；登录时命中即授予 admin 角色
ADMIN_EMAILS=

# 登录 Cookie 是否加 Secure（本地 http 调试设 false；公网 HTTPS 必须 true）
COOKIE_SECURE=true

# ===== 默认配额 =====
DEFAULT_MAX_TUNNELS=5
DEFAULT_DAILY_BYTES=10737418240
# 每用户并发流上限
MAX_STREAMS_PER_USER=64
# 每用户限流：每秒请求数 / 突发
RATE_PER_SEC=50
RATE_BURST=100

# ===== relay 角色：纯 IP TCP 中转端口池 =====
TCP_PORT_START=10000
TCP_PORT_END=10099
RELAY_HOST=47.103.21.5
